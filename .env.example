# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# DEFAULT: SQLite (no installation needed — works out of the box)
# Leave DATABASE_URL unset or use the line below for local development.
# DATABASE_URL=sqlite:///instance/project_supervision.db

# OPTIONAL: PostgreSQL (for production)
# 1. Create the database first:
#      CREATE DATABASE project_supervision;
# 2. Then uncomment and edit the line below:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/project_supervision

# Admin seed credentials (used by seed script)
ADMIN_EMAIL=admin@psms.local
ADMIN_PASSWORD=Admin@2024Secure
ADMIN_NAME=System Administrator

# Upload settings
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=app/static/uploads
